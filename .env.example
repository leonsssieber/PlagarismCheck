# Alle Schlüssel sind optional. Ohne Schlüssel nutzt die App DuckDuckGo, Wikipedia und OpenAlex.
# Mit mindestens einem Such-API-Schlüssel wird die Websuche deutlich zuverlässiger.

# Brave Search API – https://brave.com/search/api/ (monatliches Gratis-Guthaben)
BRAVE_API_KEY=

# Serper.dev (Google-Ergebnisse) – https://serper.dev (2500 Gratis-Anfragen)
SERPER_API_KEY=

# Google Programmable Search – https://programmablesearchengine.google.com (100 Anfragen/Tag gratis)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Eigene SearXNG-Instanz (JSON-Format muss aktiviert sein), z. B. https://searx.example.org
SEARXNG_URL=

# Optional: E-Mail für den "polite pool" der OpenAlex-API
OPENALEX_MAILTO=
